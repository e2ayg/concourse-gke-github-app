<diagram id="v2" name="2 Identity and trust"><mxGraphModel grid="0" page="1" pageWidth="1800" pageHeight="1160" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t1" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Identity, access and trust&lt;/b&gt;&lt;/font&gt;&lt;br&gt;View 2 of 3: who authenticates as what, and what each identity can reach. &lt;b&gt;The GitHub App (lane B) and the GitHub OAuth App (lane D) are separate identities.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1730" height="62" as="geometry"/></mxCell>
<mxCell id="a" value="A. Google Cloud identity: refresher pod to Secret Manager, no static key" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A73E8;fillColor=#F8FBFF;strokeColor=#1A73E8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="88" width="1730" height="136" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;b&gt;KSA github-token-refresher&lt;/b&gt;&lt;br&gt;Annotated with the GSA email" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="a"><mxGeometry x="30" y="36" width="230" height="84" as="geometry"/></mxCell>
<mxCell id="i2" value="" style="fillColor=#2875E2;strokeColor=#ffffff;connectable=0;shape=mxgraph.kubernetes.icon2;prIcon=sa" vertex="1" parent="a1"><mxGeometry x="8" y="25" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;b&gt;GKE metadata server&lt;/b&gt;&lt;br&gt;Workload Identity token exchange" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="a"><mxGeometry x="390" y="36" width="230" height="84" as="geometry"/></mxCell>
<mxCell id="i3" value="" style="fillColor=#2875E2;strokeColor=#ffffff;connectable=0;shape=mxgraph.kubernetes.icon2;prIcon=ds" vertex="1" parent="a2"><mxGeometry x="8" y="25" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="a3" value="&lt;b&gt;GSA concourse-token-refresher&lt;/b&gt;&lt;br&gt;Short-lived access token&lt;br&gt;&lt;font color=#137333&gt;Control: no JSON key exists&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="a"><mxGeometry x="750" y="36" width="230" height="84" as="geometry"/></mxCell>
<mxCell id="i4" value="" style="fillColor=#5184F3;strokeColor=none;connectable=0;shape=mxgraph.gcp2.hexIcon;prIcon=cloud_iam" vertex="1" parent="a3"><mxGeometry x="8" y="25" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="a4" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;GitHub App private key (PEM)&lt;br&gt;&lt;font color=#137333&gt;Control: one secret only&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="a"><mxGeometry x="1110" y="36" width="230" height="84" as="geometry"/></mxCell>
<mxCell id="i5" value="" style="fillColor=#5184F3;strokeColor=none;connectable=0;shape=mxgraph.gcp2.hexIcon;prIcon=key_management_service" vertex="1" parent="a4"><mxGeometry x="8" y="25" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="t6" value="&lt;b&gt;Trust zone:&lt;/b&gt; Google IAM decides access. Nothing in the cluster holds a Google credential at rest." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="a"><mxGeometry x="1470" y="36" width="230" height="84" as="geometry"/></mxCell>
<mxCell id="b" value="B. GitHub App: repository access for pipelines" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#202124;fillColor=#F6F8FA;strokeColor=#202124;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="236" width="1730" height="136" as="geometry"/></mxCell>
<mxCell id="b1" value="&lt;b&gt;App JWT, built by refresher&lt;/b&gt;&lt;br&gt;RS256 with the PEM, iss = App ID&lt;br&gt;&lt;font color=#137333&gt;Control: up to 10 minutes&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="b"><mxGeometry x="30" y="36" width="230" height="84" as="geometry"/></mxCell>
<mxCell id="i10" value="" style="fillColor=#2875E2;strokeColor=#ffffff;connectable=0;shape=mxgraph.kubernetes.icon2;prIcon=pod" vertex="1" parent="b1"><mxGeometry x="8" y="25" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="b2" value="&lt;b&gt;GitHub REST API&lt;/b&gt;&lt;br&gt;Verifies JWT, checks installation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="b"><mxGeometry x="390" y="36" width="230" height="84" as="geometry"/></mxCell>
<mxCell id="i11" value="" style="connectable=0;shape=mxgraph.weblogos.github" vertex="1" parent="b2"><mxGeometry x="8" y="25" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="b3" value="&lt;b&gt;Installation token&lt;/b&gt;&lt;br&gt;Stored in Secret github-app-token&lt;br&gt;&lt;font color=#137333&gt;Control: 1 h, optional repo list&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="b"><mxGeometry x="750" y="36" width="230" height="84" as="geometry"/></mxCell>
<mxCell id="i12" value="" style="fillColor=#2875E2;strokeColor=#ffffff;connectable=0;shape=mxgraph.kubernetes.icon2;prIcon=secret" vertex="1" parent="b3"><mxGeometry x="8" y="25" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="b4" value="&lt;b&gt;Concourse worker&lt;/b&gt;&lt;br&gt;Git client, user x-access-token" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="b"><mxGeometry x="1110" y="36" width="230" height="84" as="geometry"/></mxCell>
<mxCell id="i13" value="" style="fillColor=#2875E2;strokeColor=#ffffff;connectable=0;shape=mxgraph.kubernetes.icon2;prIcon=sts" vertex="1" parent="b4"><mxGeometry x="8" y="25" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="b5" value="&lt;b&gt;Private repository&lt;/b&gt;&lt;br&gt;github.com, HTTPS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="b"><mxGeometry x="1470" y="36" width="230" height="84" as="geometry"/></mxCell>
<mxCell id="i14" value="" style="connectable=0;shape=mxgraph.weblogos.github" vertex="1" parent="b5"><mxGeometry x="8" y="25" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="c" value="C. Kubernetes RBAC: who can use github-app-token" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#8430CE;fillColor=#F7F0FE;strokeColor=#8430CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="384" width="1730" height="214" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;KSA github-token-refresher&lt;/b&gt;&lt;br&gt;ns: concourse-token-refresher" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="c"><mxGeometry x="30" y="36" width="230" height="74" as="geometry"/></mxCell>
<mxCell id="i19" value="" style="fillColor=#2875E2;strokeColor=#ffffff;connectable=0;shape=mxgraph.kubernetes.icon2;prIcon=sa" vertex="1" parent="c1"><mxGeometry x="8" y="20" width="34" height="33" as="geometry"/></mxCell>
