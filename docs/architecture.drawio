<mxCell id="s50" value="" style="rounded=0;html=1;fillColor=#EEF4FE;strokeColor=#1967D2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1264" y="1300" width="26" height="14" as="geometry"/></mxCell>
<mxCell id="t51" value="GKE cluster" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1294" y="1295" width="156" height="24" as="geometry"/></mxCell>
<mxCell id="s52" value="" style="rounded=0;html=1;fillColor=#FDF0EE;strokeColor=#C5221F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1074" y="1324" width="26" height="14" as="geometry"/></mxCell>
<mxCell id="t53" value="Namespace: privileged" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1104" y="1319" width="156" height="24" as="geometry"/></mxCell>
<mxCell id="s54" value="" style="rounded=0;html=1;fillColor=#EFF8F1;strokeColor=#137333;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1264" y="1324" width="26" height="14" as="geometry"/></mxCell>
<mxCell id="t55" value="Namespace: restricted PSA" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1294" y="1319" width="156" height="24" as="geometry"/></mxCell>
<mxCell id="s56" value="" style="rounded=0;html=1;fillColor=#F7F0FE;strokeColor=#8430CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1074" y="1348" width="26" height="14" as="geometry"/></mxCell>
<mxCell id="t57" value="Namespace: credentials" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1104" y="1343" width="156" height="24" as="geometry"/></mxCell>
<mxCell id="s58" value="" style="rounded=0;html=1;fillColor=#F6F8FA;strokeColor=#202124;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1264" y="1348" width="26" height="14" as="geometry"/></mxCell>
<mxCell id="t59" value="External system" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1294" y="1343" width="156" height="24" as="geometry"/></mxCell>
<mxCell id="t60" value="&lt;b&gt;Icons:&lt;/b&gt; blue heptagon = Kubernetes object, blue hexagon = Google Cloud service (the key icon stands in for Secret Manager).&lt;br&gt;&lt;font color=#137333&gt;Control: green text marks a security control&lt;/font&gt;&lt;br&gt;&lt;b&gt;①&lt;/b&gt; to &lt;b&gt;⑫&lt;/b&gt; workflow steps; &lt;font color=#B06000&gt;&lt;b&gt;G1 to G9&lt;/b&gt;&lt;/font&gt; gaps." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1074" y="1374" width="380" height="60" as="geometry"/></mxCell>
<mxCell id="pG" value="Missing information and risks" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=13;fontStyle=1;fontColor=#B06000;fillColor=#FFFDF5;strokeColor=#B06000;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1480" y="1076" width="480" height="362" as="geometry"/></mxCell>
<mxCell id="t61" value="&lt;b&gt;G1 Entry:&lt;/b&gt; concourse_external_url is required, but the default chart has no Ingress, load balancer, DNS or TLS. Public or private exposure depends on additional_helm_values.&lt;br&gt;&lt;b&gt;G2 Network:&lt;/b&gt; VPC, subnets, CIDRs, private nodes and control-plane endpoint belong to the existing cluster.&lt;br&gt;&lt;b&gt;G3 Egress:&lt;/b&gt; ⑤ ⑩ ⑪ need outbound internet. NAT, proxy, firewall, Private Google Access and VPC-SC are not defined.&lt;br&gt;&lt;b&gt;G4 Segmentation:&lt;/b&gt; no NetworkPolicy is rendered, so east-west traffic is not limited here.&lt;br&gt;&lt;b&gt;G5 Image pull:&lt;/b&gt; the module grants no Artifact Registry read to node identities.&lt;br&gt;&lt;font color=#C5221F&gt;&lt;b&gt;G6 Risk, default secrets:&lt;/b&gt; session signing key, TSA host key, worker key and PostgreSQL password equal the public chart defaults unless the concourse_* secret variables are set.&lt;/font&gt;&lt;br&gt;&lt;b&gt;G7 Workers:&lt;/b&gt; count and node pool come from additional_helm_values. Privileged pods rule out Autopilot.&lt;br&gt;&lt;b&gt;G8 Data:&lt;/b&gt; in-cluster PostgreSQL by default; HA and backup not defined.&lt;br&gt;&lt;b&gt;G9 GitHub:&lt;/b&gt; github.com is the default; a GHES network path is not defined." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.8;" vertex="1" parent="1"><mxGeometry x="1490" y="1104" width="462" height="330" as="geometry"/></mxCell>
<mxCell id="e17" value="&lt;b&gt;① image pull, HTTPS 443&lt;/b&gt;&lt;br&gt;node identity not set&lt;br&gt;by this module (G5)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;dashed=1;startArrow=none;endArrow=block;endFill=1;strokeColor=#B06000;fontColor=#B06000;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.896;exitY=1.000;entryX=0.000;entryY=0.322;" edge="1" source="ar" target="pod" parent="1"><mxGeometry x="0.06" relative="1" as="geometry"><Array as="points"><mxPoint x="1095" y="590"/></Array></mxGeometry></mxCell>
<mxCell id="e18" value="&lt;b&gt;② HTTP 169.254.169.254&lt;/b&gt;&lt;br&gt;KSA identity&lt;br&gt;&lt;i&gt;returns GSA token&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#8430CE;fontColor=#8430CE;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.216;exitY=0.000;entryX=0.452;entryY=1.000;" edge="1" source="pod" target="md" parent="1"><mxGeometry x="0.32" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e19" value="&lt;b&gt;③ TLS 443, gRPC&lt;/b&gt;&lt;br&gt;AccessSecretVersion&lt;br&gt;GSA token&lt;br&gt;&lt;i&gt;returns PEM&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#8430CE;fontColor=#8430CE;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.927;exitY=0.000;entryX=0.099;entryY=1.000;" edge="1" source="pod" target="sm" parent="1"><mxGeometry x="-0.42" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e20" value="&lt;b&gt;⑤ HTTPS 443&lt;/b&gt;&lt;br&gt;POST .../access_tokens&lt;br&gt;Bearer App JWT&lt;br&gt;&lt;i&gt;returns token, 1 h&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#8430CE;fontColor=#8430CE;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;" edge="1" source="pod" target="gh1" parent="1"><mxGeometry x="0.53" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e21" value="&lt;b&gt;⑥ HTTPS 443&lt;/b&gt;&lt;br&gt;PATCH Secret&lt;br&gt;KSA token, RBAC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=none;endArrow=block;endFill=1;strokeColor=#8430CE;fontColor=#8430CE;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.746;entryX=1.000;entryY=0.800;" edge="1" source="pod" target="api" parent="1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e22" value="&lt;b&gt;⑥&lt;/b&gt; write  &lt;b&gt;⑧&lt;/b&gt; read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#8430CE;fontColor=#8430CE;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;" edge="1" source="api" target="sec" parent="1"><mxGeometry x="-0.3" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e23" value="&lt;b&gt;⑦ HTTPS expected&lt;/b&gt;&lt;br&gt;UI and fly CLI&lt;br&gt;Concourse login&lt;br&gt;&lt;i&gt;returns pages, status&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;" edge="1" source="users" target="web" parent="1"><mxGeometry x="-0.6" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e24" value="&lt;b&gt;⑧ HTTPS 443&lt;/b&gt;&lt;br&gt;GET Secret&lt;br&gt;KSA concourse-web&lt;br&gt;&lt;i&gt;returns token&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#8430CE;fontColor=#8430CE;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;" edge="1" source="web" target="api" parent="1"><mxGeometry x="0.05" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e25" value="&lt;b&gt;⑨ SSH :2222&lt;/b&gt;, opened by worker&lt;br&gt;worker key (default unless set, G6)&lt;br&gt;&lt;i&gt;web sends check and get work&lt;br&gt;with resolved credential&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#5F6368;fontColor=#5F6368;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;" edge="1" source="wrk" target="web" parent="1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e26" value="&lt;b&gt;⑩ HTTPS 443, git fetch&lt;/b&gt;: user x-access-token, password = installation token. &lt;i&gt;Returns repository contents&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#8430CE;fontColor=#8430CE;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.250;entryX=0.000;entryY=0.500;" edge="1" source="wrk" target="gh2" parent="1"><mxGeometry x="-0.3" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e27" value="&lt;b&gt;⑪ HTTPS 443&lt;/b&gt;: pull task image, anonymous. &lt;i&gt;Returns image layers&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#5F6368;fontColor=#5F6368;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.750;entryX=0.000;entryY=0.500;" edge="1" source="wrk" target="dh" parent="1"><mxGeometry x="-0.42" relative="1" as="geometry"><Array as="points"><mxPoint x="1650" y="935"/><mxPoint x="1650" y="1015"/></Array></mxGeometry></mxCell>
<mxCell id="e28" value="&lt;b&gt;⑫ TCP 5432&lt;/b&gt;&lt;br&gt;DB password (G6)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#5F6368;fontColor=#5F6368;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;" edge="1" source="web" target="pg" parent="1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e29" value="&lt;b&gt;Workload Identity binding&lt;/b&gt;&lt;br&gt;roles/iam.workloadIdentityUser" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;dashed=1;startArrow=none;endArrow=block;endFill=1;strokeColor=#137333;fontColor=#137333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.452;exitY=0.000;entryX=0.500;entryY=1.000;" edge="1" source="md" target="gsa" parent="1"><mxGeometry x="-0.62" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e30" value="IAM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;dashed=1;startArrow=none;endArrow=block;endFill=1;strokeColor=#137333;fontColor=#137333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;" edge="1" source="gsa" target="sm" parent="1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e33" value="" style="rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1074" y="1119" as="sourcePoint"/><mxPoint x="1130" y="1119" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e35" value="" style="rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#5F6368;fontColor=#5F6368;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1074" y="1143" as="sourcePoint"/><mxPoint x="1130" y="1143" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e37" value="" style="rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#8430CE;fontColor=#8430CE;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1074" y="1167" as="sourcePoint"/><mxPoint x="1130" y="1167" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e39" value="" style="rounded=1;html=1;strokeWidth=1.7;dashed=1;startArrow=none;endArrow=block;endFill=1;strokeColor=#137333;fontColor=#137333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1074" y="1191" as="sourcePoint"/><mxPoint x="1130" y="1191" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e41" value="" style="rounded=1;html=1;strokeWidth=1.7;dashed=1;startArrow=none;endArrow=block;endFill=1;strokeColor=#B06000;fontColor=#B06000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1074" y="1215" as="sourcePoint"/><mxPoint x="1130" y="1215" as="targetPoint"/></mxGeometry></mxCell>
