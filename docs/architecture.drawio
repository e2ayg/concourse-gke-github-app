<mxCell id="c6" value="&lt;b&gt;Scope difference to review&lt;/b&gt;&lt;br&gt;The refresher can touch one named Secret. Concourse web can read every Secret in the team namespace, which is what the credential manager needs for ((name)) lookups." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#8430CE;" vertex="1" parent="c"><mxGeometry x="1110" y="56" width="590" height="124" as="geometry"/></mxCell>
<mxCell id="d" value="D. Concourse login: GitHub OAuth App (optional) or local user. Decides who can use the UI and fly, not repository access" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=12;fontStyle=1;fontColor=#1A73E8;fillColor=#F8FBFF;strokeColor=#1A73E8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="1730" height="214" as="geometry"/></mxCell>
