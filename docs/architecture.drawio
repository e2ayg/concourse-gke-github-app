<mxCell id="egr" value="&lt;b&gt;&lt;font color=#B06000&gt;&lt;b&gt;EGRESS PATH&lt;/b&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=#B06000&gt;&lt;b&gt;NOT DEFINED&lt;/b&gt;&lt;/font&gt;&lt;br&gt;NAT, proxy and firewall rules are not in this repo (G3)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#FEF7E0;strokeColor=#B06000;dashed=1;" vertex="1" parent="vpc"><mxGeometry x="1116" y="244" width="100" height="410" as="geometry"/></mxCell>
<mxCell id="zG" value="GitHub (external SaaS, public internet)&lt;br&gt;&lt;font style=&#x27;font-weight:normal&#x27;&gt;GHES possible via github_api_url (G9)&lt;/font&gt;" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=11;fontStyle=1;fontColor=#202124;fillColor=#F6F8FA;strokeColor=#202124;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1720" y="470" width="240" height="480" as="geometry"/></mxCell>
<mxCell id="gh1" value="&lt;b&gt;GitHub REST API&lt;/b&gt;&lt;br&gt;api.github.com&lt;br&gt;&lt;font color=#137333&gt;Control: App set to Contents read-only (README)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="zG"><mxGeometry x="12" y="91" width="216" height="100" as="geometry"/></mxCell>
<mxCell id="i14" value="" style="connectable=0;shape=mxgraph.weblogos.github" vertex="1" parent="gh1"><mxGeometry x="8" y="33" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="gh2" value="&lt;b&gt;GitHub Git over HTTPS&lt;/b&gt;&lt;br&gt;github.com/ORG/private-repo.git" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="zG"><mxGeometry x="12" y="365" width="216" height="100" as="geometry"/></mxCell>
<mxCell id="i15" value="" style="connectable=0;shape=mxgraph.weblogos.github" vertex="1" parent="gh2"><mxGeometry x="8" y="33" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="zD" value="Public image registry (public internet)" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=11;fontStyle=1;fontColor=#202124;fillColor=#F6F8FA;strokeColor=#202124;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1720" y="962" width="240" height="88" as="geometry"/></mxCell>
<mxCell id="dh" value="&lt;b&gt;Docker Hub&lt;/b&gt;&lt;br&gt;busybox task image (example)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="zD"><mxGeometry x="12" y="26" width="216" height="54" as="geometry"/></mxCell>
<mxCell id="i16" value="" style="connectable=0;shape=image;image=https://icons.diagrams.net/assets/azure/1/Docker.svg" vertex="1" parent="dh"><mxGeometry x="8" y="10" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="pS" value="Main end-to-end workflow" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=14;fontStyle=1;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#202124;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="1076" width="1010" height="362" as="geometry"/></mxCell>
<mxCell id="t31" value="&lt;b&gt;A. Token refresh&lt;/b&gt; (every 30 minutes by default; tokens last 1 hour)&lt;br&gt;&lt;br&gt;&lt;b&gt;①&lt;/b&gt; The CronJob starts a refresher pod. The node pulls its image from Artifact Registry.&lt;br&gt;&lt;br&gt;&lt;b&gt;②&lt;/b&gt; The pod asks the GKE metadata server for credentials. Workload Identity returns a short-lived access token for the Google service account.&lt;br&gt;&lt;br&gt;&lt;b&gt;③&lt;/b&gt; The pod reads the GitHub App private key from Secret Manager.&lt;br&gt;&lt;br&gt;&lt;b&gt;④&lt;/b&gt; The pod signs a GitHub App JWT with RS256 (up to 10 minutes). This step makes no network call.&lt;br&gt;&lt;br&gt;&lt;b&gt;⑤&lt;/b&gt; The pod exchanges the JWT at the GitHub REST API for an installation token, optionally limited to github_repositories.&lt;br&gt;&lt;br&gt;&lt;b&gt;⑥&lt;/b&gt; The pod patches the token into Secret github-app-token through the Kubernetes API." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.6;" vertex="1" parent="1"><mxGeometry x="40" y="1104" width="490" height="330" as="geometry"/></mxCell>
<mxCell id="t32" value="&lt;b&gt;B. Pipeline run&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;⑦&lt;/b&gt; A user logs in and sets or triggers a pipeline through the UI or fly.&lt;br&gt;&lt;br&gt;&lt;b&gt;⑧&lt;/b&gt; Concourse web resolves ((github-app-token)) by reading the Secret from the team namespace through the Kubernetes API.&lt;br&gt;&lt;br&gt;&lt;b&gt;⑨&lt;/b&gt; The worker keeps an SSH tunnel to the web TSA on port 2222. Web sends check and get work, with the resolved credential, over that tunnel.&lt;br&gt;&lt;br&gt;&lt;b&gt;⑩&lt;/b&gt; The worker fetches the private repository over HTTPS with username x-access-token and the token as password.&lt;br&gt;&lt;br&gt;&lt;b&gt;⑪&lt;/b&gt; The worker pulls the task image and runs the task.&lt;br&gt;&lt;br&gt;&lt;b&gt;⑫&lt;/b&gt; Web records pipeline state in PostgreSQL and returns build status to the user." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.6;" vertex="1" parent="1"><mxGeometry x="540" y="1104" width="490" height="330" as="geometry"/></mxCell>
<mxCell id="pL" value="Legend" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=13;fontStyle=1;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#202124;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="1076" width="400" height="362" as="geometry"/></mxCell>
<mxCell id="t34" value="User request and response" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1136" y="1107" width="318" height="24" as="geometry"/></mxCell>
<mxCell id="t36" value="Service call" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1136" y="1131" width="318" height="24" as="geometry"/></mxCell>
<mxCell id="t38" value="Credential or secret movement" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1136" y="1155" width="318" height="24" as="geometry"/></mxCell>
<mxCell id="t40" value="Identity or permission binding (not traffic)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1136" y="1179" width="318" height="24" as="geometry"/></mxCell>
<mxCell id="t42" value="Path or authentication not defined" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1136" y="1203" width="318" height="24" as="geometry"/></mxCell>
<mxCell id="t43" value="&lt;b&gt;Filled head&lt;/b&gt;: request direction. &lt;b&gt;Hollow head&lt;/b&gt;: response returns this way. &lt;i&gt;Italic label text&lt;/i&gt; says what comes back." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1074" y="1232" width="380" height="36" as="geometry"/></mxCell>
