<mxCell id="n1" value="ns: concourse (privileged workers)" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=10.5;fontStyle=1;fontColor=#C5221F;fillColor=#FDF0EE;strokeColor=#C5221F;strokeWidth=1.5;" vertex="1" parent="gke"><mxGeometry x="384" y="32" width="672" height="106" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;Helm release concourse&lt;/b&gt;&lt;br&gt;Web, worker, PostgreSQL. The chart also creates team namespace concourse-main and its RoleBinding" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="n1"><mxGeometry x="16" y="28" width="640" height="66" as="geometry"/></mxCell>
<mxCell id="i9" value="" style="fillColor=#2875E2;strokeColor=#ffffff;connectable=0;shape=mxgraph.kubernetes.icon2;prIcon=deploy" vertex="1" parent="c1"><mxGeometry x="8" y="16" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="n2" value="ns: concourse-main (team credentials)" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=10.5;fontStyle=1;fontColor=#8430CE;fillColor=#F7F0FE;strokeColor=#8430CE;strokeWidth=1.5;" vertex="1" parent="gke"><mxGeometry x="384" y="150" width="672" height="106" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Secret github-app-token (placeholder), Role and RoleBinding&lt;/b&gt;&lt;br&gt;Terraform ignores data changes so the CronJob owns the value" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="n2"><mxGeometry x="16" y="28" width="640" height="66" as="geometry"/></mxCell>
<mxCell id="i10" value="" style="fillColor=#2875E2;strokeColor=#ffffff;connectable=0;shape=mxgraph.kubernetes.icon2;prIcon=secret" vertex="1" parent="c2"><mxGeometry x="8" y="16" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="n3" value="ns: concourse-token-refresher (Pod Security restricted)" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=10.5;fontStyle=1;fontColor=#137333;fillColor=#EFF8F1;strokeColor=#137333;strokeWidth=1.5;" vertex="1" parent="gke"><mxGeometry x="384" y="268" width="672" height="120" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Namespace, KSA and CronJob github-token-refresher&lt;/b&gt;&lt;br&gt;Image reference comes from step P2. KSA annotation links to the GSA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="n3"><mxGeometry x="16" y="28" width="640" height="80" as="geometry"/></mxCell>
<mxCell id="i11" value="" style="fillColor=#2875E2;strokeColor=#ffffff;connectable=0;shape=mxgraph.kubernetes.icon2;prIcon=cronjob" vertex="1" parent="c3"><mxGeometry x="8" y="23" width="34" height="33" as="geometry"/></mxCell>
<mxCell id="w" value="Provisioning order" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=14;fontStyle=1;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#202124;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="912" width="1010" height="192" as="geometry"/></mxCell>
<mxCell id="t23" value="&lt;b&gt;P1&lt;/b&gt; Register the GitHub App (Contents: read) and, optionally, the OAuth App. Download the PEM.&lt;br&gt;&lt;br&gt;&lt;b&gt;P2&lt;/b&gt; Build and push the refresher image to Artifact Registry.&lt;br&gt;&lt;br&gt;&lt;b&gt;P3&lt;/b&gt; terraform init downloads locked providers; plan and apply fetch the chart.&lt;br&gt;&lt;br&gt;&lt;b&gt;P4&lt;/b&gt; The google provider enables APIs and creates the secret container, GSA and IAM bindings." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="490" height="160" as="geometry"/></mxCell>
<mxCell id="t24" value="&lt;b&gt;P5&lt;/b&gt; The helm and kubernetes providers use a short-lived OAuth2 token and the cluster CA to install the release and create namespaces, KSA, RBAC, Secret and CronJob.&lt;br&gt;&lt;br&gt;&lt;b&gt;P6&lt;/b&gt; Add the PEM as a Secret Manager version, out-of-band.&lt;br&gt;&lt;br&gt;&lt;b&gt;P7&lt;/b&gt; Run verify-onboarding.sh (reads IAM, secret and cluster state), then set the pipeline with fly through the Concourse entry point (G1)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="940" width="490" height="160" as="geometry"/></mxCell>
<mxCell id="m" value="Missing information" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=14;fontStyle=1;fontColor=#B06000;fillColor=#FFFDF5;strokeColor=#B06000;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="912" width="690" height="192" as="geometry"/></mxCell>
<mxCell id="t25" value="&lt;b&gt;G2&lt;/b&gt; Cluster network and control-plane endpoint are not defined, so the operator&#x27;s path to the Kubernetes API is unknown.&lt;br&gt;&lt;br&gt;&lt;b&gt;G5&lt;/b&gt; The build script creates the registry only with --create-repo. Pull permission for nodes is not granted here.&lt;br&gt;&lt;br&gt;&lt;b&gt;G6&lt;/b&gt; Apply deploys the chart&#x27;s default secrets unless the concourse_* secret variables are set (views 1 and 2).&lt;br&gt;&lt;br&gt;&lt;b&gt;G10&lt;/b&gt; examples/basic has no backend block, so state is local unless the operator adds one. It holds sensitive Helm values, and the PEM too if github_app_private_key_pem is set.&lt;br&gt;&lt;br&gt;&lt;b&gt;G11&lt;/b&gt; The IAM roles the operator needs to run apply are described only in general terms." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="1070" y="940" width="672" height="160" as="geometry"/></mxCell>
<mxCell id="z26" value="Legend" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=11;fontStyle=1;fontColor=#202124;fillColor=#FFFFFF;strokeColor=#202124;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="1118" width="1720" height="62" as="geometry"/></mxCell>
<mxCell id="t28" value="User request" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="140" y="1127" width="120" height="22" as="geometry"/></mxCell>
<mxCell id="t30" value="Service call" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="314" y="1127" width="112" height="22" as="geometry"/></mxCell>
<mxCell id="t32" value="Credential movement" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="1127" width="164" height="22" as="geometry"/></mxCell>
<mxCell id="t34" value="Identity or permission binding" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="698" y="1127" width="214" height="22" as="geometry"/></mxCell>
<mxCell id="t36" value="Not defined" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="966" y="1127" width="110" height="22" as="geometry"/></mxCell>
<mxCell id="t37" value="&lt;b&gt;Filled head&lt;/b&gt;: request. &lt;b&gt;Hollow head&lt;/b&gt;: response. &lt;font color=#137333&gt;Control: green text marks a security control.&lt;/font&gt; &lt;font color=#B06000&gt;&lt;b&gt;Amber: not defined in the repo.&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="96" y="1152" width="1640" height="24" as="geometry"/></mxCell>
<mxCell id="e12" value="&lt;b&gt;P1 HTTPS, operator login&lt;/b&gt;&lt;br&gt;register apps &lt;i&gt;returns App ID, PEM&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#1A73E8;fontColor=#1A73E8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.262;entryX=0.000;entryY=0.500;" edge="1" source="o1" target="g1" parent="1"><mxGeometry x="-0.05" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e13" value="&lt;b&gt;P2 HTTPS 443, docker push&lt;/b&gt;&lt;br&gt;gcloud credential helper" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=none;endArrow=block;endFill=1;strokeColor=#5F6368;fontColor=#5F6368;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.476;" edge="1" source="o2" target="ar" parent="1"><mxGeometry x="0.37" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e14" value="&lt;b&gt;P3 HTTPS 443&lt;/b&gt;: download providers and chart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#5F6368;fontColor=#5F6368;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.182;entryX=0.500;entryY=1.000;" edge="1" source="o3" target="zr" parent="1"><mxGeometry x="0.15" relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="520"/><mxPoint x="470" y="247"/><mxPoint x="1380" y="247"/></Array></mxGeometry></mxCell>
<mxCell id="e15" value="&lt;b&gt;P4 HTTPS 443, user ADC&lt;/b&gt;: google provider creates project resources" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#5F6368;fontColor=#5F6368;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.436;entryX=0.500;entryY=1.000;" edge="1" source="o3" target="iam" parent="1"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="548"/><mxPoint x="560" y="452"/><mxPoint x="1130" y="452"/></Array></mxGeometry></mxCell>
<mxCell id="e16" value="&lt;b&gt;P5 HTTPS 443&lt;/b&gt;&lt;br&gt;google_client_config&lt;br&gt;token + cluster CA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#5F6368;fontColor=#5F6368;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.691;entryX=0.000;entryY=0.622;" edge="1" source="o3" target="api" parent="1"><mxGeometry x="-0.3" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e17" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;dashed=1;startArrow=none;endArrow=block;endFill=1;strokeColor=#B06000;fontColor=#B06000;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;" edge="1" source="o3" target="o4" parent="1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e18" value="&lt;b&gt;P6 HTTPS 443, gcloud user&lt;/b&gt;: add PEM version, after apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=none;endArrow=block;endFill=1;strokeColor=#8430CE;fontColor=#8430CE;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;entryX=0.503;entryY=1.000;" edge="1" source="o5" target="sm" parent="1"><mxGeometry x="0.42" relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="748"/><mxPoint x="610" y="468"/><mxPoint x="1520" y="468"/></Array></mxGeometry></mxCell>
<mxCell id="e19" value="&lt;b&gt;P7 HTTPS 443&lt;/b&gt;&lt;br&gt;verify, read-only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.7;startArrow=block;startFill=0;endArrow=block;endFill=1;strokeColor=#5F6368;fontColor=#5F6368;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;entryX=0.500;entryY=1.000;" edge="1" source="o6" target="api" parent="1"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="795" y="842"/></Array></mxGeometry></mxCell>
