<diagram id="v3" name="3 Build and provisioning"><mxGraphModel grid="0" page="1" pageWidth="1800" pageHeight="1200" adaptiveColors="none"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t1" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Build and provisioning&lt;/b&gt;&lt;/font&gt;&lt;br&gt;View 3 of 3: how an operator creates the system. The repo never runs apply or destroy; the operator does. Runtime traffic is in view 1." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1730" height="62" as="geometry"/></mxCell>
