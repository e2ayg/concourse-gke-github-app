<mxCell id="gke" value="Existing GKE cluster: var.cluster_name (not created here)" style="whiteSpace=wrap;html=1;container=1;collapsible=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=3;fontSize=11;fontStyle=1;fontColor=#1967D2;fillColor=#EEF4FE;strokeColor=#1967D2;strokeWidth=1.5;" vertex="1" parent="prj"><mxGeometry x="16" y="212" width="1078" height="402" as="geometry"/></mxCell>
<mxCell id="api" value="&lt;b&gt;Kubernetes API&lt;/b&gt;&lt;br&gt;GKE control plane, HTTPS 443&lt;br&gt;&lt;font color=#B06000&gt;&lt;b&gt;Endpoint type not defined (G2)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="gke"><mxGeometry x="34" y="40" width="210" height="90" as="geometry"/></mxCell>
