<mxCell id="c3" value="&lt;b&gt;Secret github-app-token&lt;/b&gt;&lt;br&gt;ns: concourse-main, key: value&lt;br&gt;Terraform ignores data changes, so it does not fight the CronJob" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=48;fontSize=10;fillColor=#FFFFFF;strokeColor=#80868B;" vertex="1" parent="c"><mxGeometry x="750" y="36" width="230" height="164" as="geometry"/></mxCell>
